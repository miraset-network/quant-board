NANSEN_API_KEY=your_api_key_here
PORT_API=3001
CACHE_TTL_SECONDS=300
REBALANCE_THRESHOLD=0.05

# PostgreSQL (optional). If empty/unreachable, persistence is disabled.
DATABASE_URL=postgresql://fomo:fomo@localhost:5432/fomo_indexes

# Redis (optional). If empty/unreachable, API falls back to in-memory cache.
REDIS_URL=redis://localhost:6379

# Min credits before fetching optional indicators (protects budget).
MIN_CREDITS_FOR_RISK=20
{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "bun run test*": "allow",
      "bun run lint*": "allow",
      "bun run build*": "allow",
      "cat .env": "deny",
      "cat .env*": "deny",
      "rm *": "deny",
      "sudo *": "deny",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git rebase*": "ask",
      "git filter-branch*": "deny",
      "git clean*": "ask"
    },
    "external_directory": "deny"
  }
}

# Nansen API Key (required)
NANSEN_API_KEY=your_api_key_here

# Optional: Override token address (skips Smart Money auto-selection)
# SMTA_TOKEN_ADDRESS=0x95669a6589a81a6704bab1020722d0c405841885

# Optional: Lookback window in days (default: 7)
# SMTA_LOOKBACK_DAYS=7

# Optional: Chain (default: ethereum)
# SMTA_CHAIN=ethereum